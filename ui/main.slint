import { Button, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "B-Emu";
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1100px;
    preferred-height: 700px;
    background: #020617;

    VerticalBox {
        padding: 32px;
        spacing: 18px;

        Text {
            text: "B-Emu";
            color: #67E8F9;
            font-size: 42px;
            font-weight: 800;
        }

        Text {
            text: "EMULATION FRONTEND";
            color: #818CF8;
            font-size: 13px;
            letter-spacing: 3px;
        }

        Rectangle {
            background: #0A1530;
            border-radius: 18px;
            border-width: 1px;
            border-color: #1E3A5F;
            VerticalBox {
                padding: 28px;
                spacing: 12px;
                Text {
                    text: "Wayland session active";
                    color: #A5F3FC;
                    font-size: 24px;
                    font-weight: 700;
                }
                Text {
                    text: "Phase 0 prototype — native Wayland backend";
                    color: #E0F2FE;
                    font-size: 16px;
                }
                Text {
                    text: "Renderer selection: FemtoVG (GPU) with software fallback available.";
                    color: #7DD3FC;
                    font-size: 14px;
                }
            }
        }

        Button {
            text: "Prototype ready";
            enabled: false;
        }

        Text {
            text: "B-Emu is an independent project. No other Bubble project is required.";
            color: #64748B;
            font-size: 12px;
        }
    }
}
