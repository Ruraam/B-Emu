import { Theme } from "../theme.slint";
import { GlassPanel } from "../components/glass-panel.slint";
import { PageHeader } from "../components/page-header.slint";
import { ListRow } from "../components/list-row.slint";
import { StatusPill } from "../components/status-pill.slint";

component Toggle inherits Rectangle {
    in property<bool> on: false;

    width: 42px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent-cyan : Theme.border;

    Rectangle {
        x: root.on ? 22px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.on ? #020617 : Theme.text-secondary;
    }
}

export component SettingsScreen inherits VerticalLayout {
    in property<bool> auto-scan: true;
    in property<bool> vibration: true;
    in property<bool> reduced-motion: false;
    in property<[string]> game-dirs;
    in property<string> scan-status: "Prêt";
    in property<float> scan-progress: 0;
    in-out property<string> new-dir-text: "";
    in property<int> focused-item: 0;
    in property<bool> content-focused: false;

    callback toggle-setting(int);
    callback add-dir(string);
    callback remove-dir(int);
    callback scan-now();

    spacing: 14px;

    PageHeader {
        eyebrow: "B-EMU / PARAMÈTRES";
        title: "Paramètres";
        subtitle: "Préférences et dossiers de jeux, conservés dans les répertoires XDG.";
    }

    VerticalLayout {
        spacing: 8px;

        ListRow {
            focused: root.content-focused && root.focused-item == 0;
            selected: root.focused-item == 0;
            activated => { root.toggle-setting(0); }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: "Analyse automatique"; color: Theme.text-primary; font-size: 14px; font-weight: 600; }
                Text { text: "Indexer les dossiers au démarrage"; color: Theme.text-muted; font-size: 11px; }
            }
            Toggle { on: root.auto-scan; }
        }

        ListRow {
            focused: root.content-focused && root.focused-item == 1;
            selected: root.focused-item == 1;
            activated => { root.toggle-setting(1); }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: "Retour de force"; color: Theme.text-primary; font-size: 14px; font-weight: 600; }
                Text { text: "Vibration de la manette lors de la navigation"; color: Theme.text-muted; font-size: 11px; }
            }
            Toggle { on: root.vibration; }
        }

        ListRow {
            focused: root.content-focused && root.focused-item == 2;
            selected: root.focused-item == 2;
            activated => { root.toggle-setting(2); }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: "Réduire les animations"; color: Theme.text-primary; font-size: 14px; font-weight: 600; }
                Text { text: "Désactiver les transitions de l'interface"; color: Theme.text-muted; font-size: 11px; }
            }
            Toggle { on: root.reduced-motion; }
        }
    }

    GlassPanel {
        panel-padding: 14px;
        panel-spacing: 8px;

        Text { text: "DOSSIERS DE JEUX"; color: Theme.accent-indigo; font-size: 10px; font-weight: 700; letter-spacing: 1.5px; }

        if root.game-dirs.length == 0: Text {
            text: "Aucun dossier configuré.";
            color: Theme.text-muted;
            font-size: 12px;
        }

        for dir[i] in root.game-dirs: ListRow {
            focused: root.content-focused && root.focused-item == 3 + i;
            selected: root.focused-item == 3 + i;
            activated => { root.remove-dir(i); }
            Text { text: dir; color: Theme.text-secondary; font-size: 12px; horizontal-stretch: 1; overflow: elide; }
            Text { text: "×"; color: Theme.accent-cyan; font-size: 16px; }
        }

        TextInput {
            text: root.new-dir-text;
            color: Theme.text-primary;
            font-size: 12px;
            edited => { root.new-dir-text = self.text; }
        }

        ListRow {
            focused: root.content-focused && root.focused-item == 3 + root.game-dirs.length;
            selected: root.focused-item == 3 + root.game-dirs.length;
            activated => { root.add-dir(root.new-dir-text); }
            Text { text: "AJOUTER LE DOSSIER"; color: Theme.accent-cyan; font-size: 12px; font-weight: 700; letter-spacing: 1px; }
        }

        ListRow {
            focused: root.content-focused && root.focused-item == 4 + root.game-dirs.length;
            selected: root.focused-item == 4 + root.game-dirs.length;
            activated => { root.scan-now(); }
            Text { text: "ANALYSER MAINTENANT"; color: Theme.accent-blue; font-size: 12px; font-weight: 700; letter-spacing: 1px; }
        }

        Rectangle {
            height: 5px;
            border-radius: 3px;
            background: Theme.border;

            Rectangle {
                width: parent.width * root.scan-progress;
                height: parent.height;
                border-radius: 3px;
                background: Theme.accent-cyan;
            }
        }

        Text { text: root.scan-status; color: Theme.text-muted; font-size: 11px; }
    }

    Rectangle {
        vertical-stretch: 1;
        background: transparent;
    }

    GlassPanel {
        panel-padding: 14px;
        Text { text: "SYSTÈME"; color: Theme.accent-indigo; font-size: 10px; font-weight: 700; letter-spacing: 1.5px; }
        Text { text: "Linux · Wayland natif · rendu FemtoVG / logiciel"; color: Theme.text-secondary; font-size: 12px; }
        Text { text: "B-Emu est autonome : BubbleWM n'est pas une dépendance."; color: Theme.text-muted; font-size: 11px; }
    }

    StatusPill { label: "↑ ↓ OPTION  ·  A VALIDER  ·  B RETOUR"; positive: true; }
}
