// Shared view models for the Phase 1 application shell.
//
// These types are filled by the Rust shell module. Keeping them here lets the
// screens stay data-driven: Phase 2/3 services can replace the seed data
// without rewriting the interface.

export enum NavAction {
    up,
    down,
    left,
    right,
    confirm,
    back,
    favorite,
    played,
}

export struct GameCard {
    title: string,
    system: string,
    detail: string,
    accent: color,
}

export struct SystemCard {
    name: string,
    manufacturer: string,
    game-count: int,
    accent: color,
}

// A game indexed from the user's own files (Phase 2).
export struct IndexedGame {
    title: string,
    system: string,
    path: string,
    size: string,
    accent: color,
    duplicate: bool,
    favorite: bool,
    description: string,
    year: string,
    region: string,
    provider: string,
    artwork: image,
    has-artwork: bool,
}

export struct BiosRow {
    name: string,
    system: string,
    present: bool,
    checksum: string,
}

// Aggregated system information from the SQLite index.
export struct SystemStat {
    name: string,
    game-count: int,
    accent: color,
}

export struct CapabilityRow {
    key: string,
    label: string,
    flag: string,
    enabled: bool,
}

export struct EmulatorRow {
    id: string,
    name: string,
    version: string,
    status: string,
    systems: string,
    bios: string,
    ready: bool,
}
