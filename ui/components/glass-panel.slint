import { Theme } from "../theme.slint";

export component GlassPanel inherits Rectangle {
    in property<length> panel-padding: 22px;

    background: Theme.panel;
    border-radius: 18px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: root.panel-padding;
        spacing: 12px;
        @children
    }
}
